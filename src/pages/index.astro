---
// Home page. The site owner redesigns this page with an AI agent (see AGENTS.md).
// It must keep a link to /portfolio/.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>Jordan Avery</title>
    <meta name="description" content="Welcome to Jordan Avery's corner of the internet." />
    <link rel="stylesheet" href="/theme.css" />
  </head>
  <body>
    <main class="home">
      <header class="welcome">
        <p class="hello">hello, and welcome</p>
        <h1>I'm Jordan Avery.</h1>
        <p class="intro">
          Glad you stopped by. Stay for a quick game, or head straight to my work.
        </p>
      </header>

      <section class="game" aria-labelledby="game-title">
        <h2 id="game-title">Fancy a game?</h2>

        <nav class="game-tabs" aria-label="Select a game">
          <button type="button" class="game-tab active" data-game-tab="checkers">Checkers</button>
          <button type="button" class="game-tab" data-game-tab="chess">Chess</button>
          <button type="button" class="game-tab" data-game-tab="c4">Connect Four</button>
        </nav>

        <div class="game-panel" data-checkers>
          <p class="how">
            Checkers. You're terracotta and you move first. Pick a piece, then a highlighted
            square. Jumps are required.
          </p>
          <div class="board" data-board aria-label="Checkers board"></div>
          <div class="game-bar">
            <p class="status" data-status aria-live="polite"></p>
            <button type="button" class="reset" data-reset>New game</button>
          </div>
        </div>

        <div class="game-panel" data-chess hidden>
          <p class="how">
            Chess. You're terracotta and you move first. Pick a piece, then a highlighted square.
            Pawns promote to queens.
          </p>
          <div class="board" data-board aria-label="Chess board"></div>
          <div class="game-bar">
            <p class="status" data-status aria-live="polite"></p>
            <button type="button" class="reset" data-reset>New game</button>
          </div>
        </div>

        <div class="game-panel" data-c4 hidden>
          <p class="how">
            Connect Four. You're terracotta and you move first. Pick any column to drop your chip.
            Connect four in a row horizontally, vertically, or diagonally.
          </p>
          <div class="c4-board" data-board aria-label="Connect Four board"></div>
          <div class="game-bar">
            <p class="status" data-status aria-live="polite"></p>
            <button type="button" class="reset" data-reset>New game</button>
          </div>
        </div>
      </section>

      <a href="/portfolio/" class="portfolio-link">See my portfolio <span aria-hidden="true">→</span></a>
    </main>

    <script>
      import { startCheckers } from '../home/checkers.js';
      import { startChess } from '../home/chess.js';
      import { startConnectFour } from '../home/connect-four.js';

      const panels = {
        checkers: document.querySelector('[data-checkers]'),
        chess: document.querySelector('[data-chess]'),
        c4: document.querySelector('[data-c4]'),
      };
      const tabs = document.querySelectorAll('[data-game-tab]');
      const started = {
        checkers: false,
        chess: false,
        c4: false,
      };

      function switchGame(key) {
        tabs.forEach((tab) => {
          tab.classList.toggle('active', tab.dataset.gameTab === key);
        });
        Object.entries(panels).forEach(([k, panel]) => {
          if (!panel) return;
          panel.hidden = k !== key;
        });
        if (key === 'checkers' && !started.checkers && panels.checkers) {
          startCheckers(panels.checkers);
          started.checkers = true;
        } else if (key === 'chess' && !started.chess && panels.chess) {
          startChess(panels.chess);
          started.chess = true;
        } else if (key === 'c4' && !started.c4 && panels.c4) {
          startConnectFour(panels.c4);
          started.c4 = true;
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.gameTab;
          if (key) switchGame(key);
        });
      });

      // Start default game
      if (panels.checkers) {
        startCheckers(panels.checkers);
        started.checkers = true;
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
  }

  .home {
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 16px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }

  .welcome {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hello {
    font-family: var(--font-hand);
    font-size: 30px;
    color: var(--accent);
    margin: 0;
  }

  .welcome h1 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(38px, 8vw, 58px);
    line-height: 1.1;
    margin: 0;
  }

  .intro,
  .how {
    color: var(--text-soft);
    line-height: 1.7;
    margin: 0;
  }

  .intro {
    font-size: 18px;
  }

  .game {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border-radius: 24px;
    padding: 28px 20px;
    box-shadow: 0 1px 0 #cdd8cb;
  }

  .game h2 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 26px;
    margin: 0;
  }

  .how {
    font-size: 14px;
    max-width: 420px;
  }

  .game-panel {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .game-panel[hidden] {
    display: none;
  }

  .board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    width: min(100%, 420px);
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 6px solid var(--placeholder-bg);
  }

  .square {
    position: relative;
    min-width: 0;
    min-height: 0;
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    place-items: center;
    font: inherit;
  }

  .square.light {
    background: var(--bg);
  }

  .square.dark {
    background: var(--placeholder-text);
    background: color-mix(in srgb, var(--text-faint) 55%, var(--bg));
  }

  .square.movable,
  .square.target {
    cursor: pointer;
  }

  .square.selected {
    box-shadow: inset 0 0 0 3px var(--text);
  }

  .square.last {
    background-image: linear-gradient(
      color-mix(in srgb, var(--accent) 22%, transparent),
      color-mix(in srgb, var(--accent) 22%, transparent)
    );
  }

  .square.target::after {
    content: '';
    position: absolute;
    inset: 36%;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .square.target.capture::after {
    inset: 6%;
    background: transparent;
    border: 3px solid var(--accent);
    opacity: 0.8;
  }

  .square:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: -3px;
  }

  .piece {
    position: relative;
    width: 74%;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.2), 0 2px 3px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  .piece.you {
    background: var(--accent);
  }

  .piece.cpu {
    background: var(--text);
  }

  /* The crown sits on top of the piece so it can't change the piece's size. */
  .piece.king::after {
    content: '♔';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-ink);
    font-size: clamp(14px, 4.5vw, 24px);
    line-height: 1;
  }

  .chess-piece {
    position: relative;
    font-size: clamp(24px, 8vw, 40px);
    line-height: 1;
    pointer-events: none;
  }

  .chess-piece.w {
    color: var(--accent);
    text-shadow: 0 0 2px var(--accent-ink), 0 1px 1px rgba(0, 0, 0, 0.25);
  }

  .chess-piece.b {
    color: var(--text);
    text-shadow: 0 0 2px var(--bg-card);
  }

  .game-tabs {
    display: inline-flex;
    gap: 6px;
    background: var(--bg);
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--placeholder-bg);
  }

  .game-tab {
    border: 0;
    background: transparent;
    color: var(--text-soft);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .game-tab:hover {
    color: var(--text);
  }

  .game-tab.active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .c4-board {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-template-rows: repeat(6, 1fr);
    width: min(100%, 420px);
    aspect-ratio: 7 / 6;
    border-radius: 14px;
    padding: 10px;
    gap: 8px;
    background: color-mix(in srgb, var(--text-faint) 45%, var(--bg));
    border: 6px solid var(--placeholder-bg);
  }

  .c4-cell {
    position: relative;
    border-radius: 50%;
    border: 0;
    padding: 0;
    margin: 0;
    background: var(--bg);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.22);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }

  .c4-cell:disabled {
    cursor: default;
  }

  .c4-cell.col-hover:not(.filled) {
    background: color-mix(in srgb, var(--accent) 30%, var(--bg));
  }

  .c4-cell:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 2px;
  }

  .c4-piece {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.25), 0 2px 4px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    display: block;
  }

  .c4-cell.latest .c4-piece {
    animation: dropIn 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .c4-piece.you {
    background: var(--accent);
  }

  .c4-piece.cpu {
    background: var(--text);
  }

  .c4-cell.winning .c4-piece {
    box-shadow: 0 0 0 3px #ffd166, inset 0 -3px 0 rgba(0, 0, 0, 0.25);
    animation: c4Pulse 1.1s infinite alternate ease-in-out;
  }

  @keyframes dropIn {
    from {
      transform: translateY(-40px);
      opacity: 0.6;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes c4Pulse {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  .game-bar {
    width: min(100%, 420px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .status {
    margin: 0;
    font-size: 14px;
    text-align: left;
    color: var(--text-soft);
  }

  .reset {
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .reset:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .portfolio-link {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 999px;
    padding: 16px 34px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .portfolio-link:hover {
    background: var(--accent-hover);
  }
</style>
